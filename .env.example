NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NUXT_PUBLIC_API_BASE_PATH=/api/v1
# During `npm run dev`, browser API requests use Nuxt's same-origin proxy at
# /api/v1. Keep the backend URL here as the proxy target.
NUXT_PUBLIC_EVENT_SLUG=iwbif-2026
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=IWBIF 2026
NUXT_PUBLIC_PAYMENT_PROVIDER=midtrans

# Supported values: doku | midtrans. The current production provider is Midtrans.
# `npm run build` and `npm run generate` always use these production URLs:
# API base URL: https://api.iwbif.id
# Site URL: https://iwbif.id
